{
  "version": 2,
  "functions": {
    "api/chat.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/pages/index.html"
    },
    {
      "source": "/((?!api|_next|favicon.ico|components|styles|scripts|images|data).*)",
      "destination": "/pages/$1"
    }
  ]
}